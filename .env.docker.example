# Copy this file to .env before running Docker Compose.
APP_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-value

MYSQL_DATABASE=usclosers
MYSQL_USER=usclosers
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password

# Use the Compose service name `db`, not localhost.
DATABASE_URL=mysql://usclosers:replace-with-a-strong-password@db:3306/usclosers
