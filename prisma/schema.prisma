generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  offers    Offer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offer {
  id          String      @id @default(uuid())
  name        String
  concept     String      @db.Text
  pain        String      @db.Text
  action      String      @db.Text
  features    Json        // Array of feature strings
  basePrice   Decimal     @db.Decimal(10, 2)
  deliverySla String
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  components  Component[]
  rulesEngine Json?       // Rules for configurator
  presets     Json?       // Predefined templates
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Component {
  id          String   @id @default(uuid())
  name        String
  type        String   // e.g., "required", "addon"
  description String   @db.Text
  whyNeedThis String?  @db.Text
  offerId     String
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  options     Option[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vendor {
  id        String   @id @default(uuid())
  name      String
  rating    Decimal  @default(0.0) @db.Decimal(3, 1)
  options   Option[]
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Option {
  id             String     @id @default(uuid())
  name           String
  description    String     @db.Text
  priceDelta     Decimal    @default(0) @db.Decimal(10, 2)
  isDefault      Boolean    @default(false)
  type           String     // e.g., "internal", "external"
  requiresUpload Boolean    @default(false)
  whyNeedThis    String?    @db.Text
  unitName       String?
  minQuantity    Int        @default(1)
  maxQuantity    Int?
  step           Int        @default(1)
  slaImpact      String?    // e.g., "NONE", "DOWNGRADE_TO_BASIC"
  componentId    String
  component      Component  @relation(fields: [componentId], references: [id], onDelete: Cascade)
  vendorId       String?
  vendor         Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  tasks          Task[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Order {
  id            String   @id @default(uuid())
  customerName  String
  customerEmail String
  status        String   @default("DRAFT") // DRAFT, PENDING, ACTIVE, COMPLETED
  totalPrice    Decimal  @db.Decimal(10, 2)
  draftData     Json?
  tasks         Task[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Task {
  id            String    @id @default(uuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  optionId      String
  option        Option    @relation(fields: [optionId], references: [id], onDelete: Restrict)
  vendorId      String?
  vendor        Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  status        String    @default("ACTION_REQUIRED") // ACTION_REQUIRED, PENDING, IN_PROGRESS, REVIEW, COMPLETED
  slaDeadline   DateTime?
  deliverables  Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

